<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="288dp"
    android:layout_height="match_parent"
    android:background="@color/sub_color_light"
    android:id="@+id/side_menu"
    android:fitsSystemWindows="true" >

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="90dp" />

    <Button
        android:id="@+id/close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/guideline"
        android:background="@drawable/icon_close" />

    <TextView
        android:id="@+id/private_setting"
        android:layout_width="254dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:gravity="start"
        android:ems="30"
        android:fontFamily="@font/font_bold"
        android:text=" 개인 설정"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/close" />

    <View
        android:id="@+id/line1"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="3dp"
        app:layout_constraintTop_toBottomOf="@+id/private_setting" />

    <Button
        android:id="@+id/basic_setting"
        style="?android:attr/borderlessButtonStyle"
        android:layout_marginTop="3dp"
        android:layout_width="195dp"
        android:layout_height="35dp"
        android:fontFamily="@font/font_medium"
        android:gravity="start"
        android:text="개인정보 수정"
        android:textSize="15sp"
        android:background="@color/sub_color_light"
        android:paddingVertical="10dp"
        android:paddingStart="10dp"
        app:layout_constraintStart_toStartOf="@+id/private_setting"
        app:layout_constraintTop_toBottomOf="@+id/line1" />

    <Button
        android:id="@+id/health_setting"
        android:layout_width="195dp"
        android:layout_height="35dp"
        android:gravity="start"
        style="?android:attr/borderlessButtonStyle"
        android:fontFamily="@font/font_medium"
        android:text="신체정보 및 개인목표 수정"
        android:textSize="15sp"
        android:background="@color/sub_color_light"
        android:paddingVertical="10dp"
        android:paddingStart="10dp"
        app:layout_constraintStart_toStartOf="@+id/private_setting"
        app:layout_constraintTop_toBottomOf="@+id/basic_setting" />

    <Button
        android:id="@+id/feeling_setting"
        android:layout_width="195dp"
        android:layout_height="35dp"
        android:gravity="start"
        style="?android:attr/borderlessButtonStyle"
        android:fontFamily="@font/font_medium"
        android:text="선호 느낌 수정"
        android:textSize="15sp"
        android:background="@color/sub_color_light"
        android:paddingVertical="10dp"
        android:paddingStart="10dp"
        app:layout_constraintStart_toStartOf="@+id/private_setting"
        app:layout_constraintTop_toBottomOf="@+id/health_setting" />

    <Button
        android:id="@+id/taste_setting"
        android:layout_width="195dp"
        android:layout_height="35dp"
        android:gravity="start"
        style="?android:attr/borderlessButtonStyle"
        android:fontFamily="@font/font_medium"
        android:text="선호 맛 수정"
        android:textSize="15sp"
        android:background="@color/sub_color_light"
        android:paddingVertical="10dp"
        android:paddingStart="10dp"
        app:layout_constraintStart_toStartOf="@+id/private_setting"
        app:layout_constraintTop_toBottomOf="@+id/feeling_setting" />

    <Button
        android:id="@+id/company_setting"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="195dp"
        android:gravity="start"
        android:layout_height="35dp"
        android:fontFamily="@font/font_medium"
        android:text="선호 브랜드 수정"
        android:textSize="15dp"
        android:background="@color/sub_color_light"
        android:paddingVertical="10dp"
        android:paddingStart="10dp"
        app:layout_constraintStart_toStartOf="@+id/private_setting"
        app:layout_constraintTop_toBottomOf="@+id/taste_setting" />

    <Button
        android:id="@+id/particular_setting"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="195dp"
        android:gravity="start"
        android:layout_height="35dp"
        android:fontFamily="@font/font_medium"
        android:text="개인 특이사항 수정"
        android:textSize="15dp"
        android:background="@color/sub_color_light"
        android:paddingVertical="10dp"
        android:paddingStart="10dp"
        app:layout_constraintStart_toStartOf="@+id/private_setting"
        app:layout_constraintTop_toBottomOf="@+id/company_setting" />

    <TextView
        android:id="@+id/booster_detail"
        android:layout_width="254dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/font_bold"
        android:layout_marginStart="5dp"
        android:text=" 보충제"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/particular_setting" />

    <View
        android:id="@+id/line2"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="3dp"
        app:layout_constraintTop_toBottomOf="@+id/booster_detail" />

    <Button
        android:id="@+id/booster_record"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="195dp"
        android:layout_height="35dp"
        android:fontFamily="@font/font_medium"
        android:gravity="start"
        android:layout_marginTop="3dp"
        android:text="보충제 제공 이력"
        android:textSize="15sp"
        android:background="@color/sub_color_light"
        android:paddingVertical="10dp"
        android:paddingStart="10dp"
        app:layout_constraintStart_toStartOf="@+id/booster_detail"
        app:layout_constraintTop_toBottomOf="@+id/line2" />

    <Button
        android:id="@+id/booster_favorite"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="195dp"
        android:layout_height="35dp"
        android:fontFamily="@font/font_medium"
        android:text="즐겨찾는 보충제"
        android:textSize="15sp"
        android:gravity="start"
        android:background="@color/sub_color_light"
        android:paddingVertical="10dp"
        android:paddingStart="10dp"
        app:layout_constraintStart_toStartOf="@+id/booster_record"
        app:layout_constraintTop_toBottomOf="@+id/booster_record" />

    <TextView
        android:id="@+id/payment"
        android:layout_width="254dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:ems="30"
        android:fontFamily="@font/font_bold"
        android:text=" 결제 및 포인트"
        android:layout_marginStart="5dp"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/booster_favorite" />

    <View
        android:id="@+id/line3"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="3dp"
        app:layout_constraintTop_toBottomOf="@+id/payment" />

    <Button
        android:id="@+id/payment_record"
        android:layout_width="195dp"
        android:layout_height="35dp"
        android:fontFamily="@font/font_medium"
        android:text="결제내역 확인"
        android:textSize="15sp"
        android:gravity="start"
        android:background="@color/sub_color_light"
        android:paddingVertical="10dp"
        android:paddingStart="10dp"
        style="?android:attr/borderlessButtonStyle"
        app:layout_constraintStart_toStartOf="@+id/payment"
        app:layout_constraintTop_toBottomOf="@+id/line3" />

    <Button
        android:id="@+id/reward"
        android:layout_width="195dp"
        android:layout_height="35dp"
        android:fontFamily="@font/font_medium"
        style="?android:attr/borderlessButtonStyle"
        android:text="쿠폰 및 포인트"
        android:textSize="15sp"
        android:gravity="start"
        android:background="@color/sub_color_light"
        android:paddingVertical="10dp"
        android:paddingStart="10dp"
        app:layout_constraintStart_toStartOf="@+id/payment"
        app:layout_constraintTop_toBottomOf="@+id/payment_record" />

    <Button
        android:id="@+id/log_out"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginBottom="10dp"
        android:layout_marginHorizontal="10dp"
        android:text="로그아웃"
        android:textColor="@color/black"
        android:fontFamily="@font/font_medium"
        android:textSize="17sp"
        style="?android:attr/borderlessButtonStyle"
        android:background="@drawable/back_fragment"
        app:layout_constraintBottom_toTopOf="@+id/delete_account"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/delete_account"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginBottom="15dp"
        android:layout_marginHorizontal="10dp"
        android:text="회원탈퇴"
        android:textColor="@color/main_color"
        android:fontFamily="@font/font_medium"
        android:textSize="17sp"
        style="?android:attr/borderlessButtonStyle"
        android:background="@drawable/btn_black_with_main"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>